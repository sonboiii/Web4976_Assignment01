@model CandidateForm

@{
    ViewData["Title"] = Model.CandidateId == 0 ? "Add candidate" : "Edit candidate";
}

<h1>@ViewData["Title"]</h1>

<form method="post" class="admin-form d-grid gap-2" enctype="multipart/form-data">
    <input asp-for="CandidateId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>

    <label asp-for="MunicipalityId" class="form-label"></label>
    <select asp-for="MunicipalityId" asp-items="ViewBag.Municipalities" class="form-select" data-candidate-municipality>
        <option value="0">Choose municipality</option>
    </select>
    <span asp-validation-for="MunicipalityId" class="text-danger"></span>

    <label asp-for="PositionId" class="form-label"></label>
    <select asp-for="PositionId" class="form-select" data-candidate-position>
        <option value="0">Choose position</option>
        @foreach (Position p in ViewBag.Positions)
        {
            <option value="@p.PositionId" data-municipality="@p.MunicipalityId">@p.Name · @p.Municipality.Name</option>
        }
    </select>
    <span asp-validation-for="PositionId" class="text-danger"></span>

    <label asp-for="Tagline" class="form-label"></label>
    <input asp-for="Tagline" class="form-control" />

    <label asp-for="Profile" class="form-label"></label>
    <textarea asp-for="Profile" class="form-control" rows="6" maxlength="3000"></textarea>
    <span asp-validation-for="Profile" class="text-danger"></span>

    <label asp-for="Image" class="form-label"></label>
    <input asp-for="Image" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" />
    <div class="form-text">JPG, PNG, or WebP · 2 MB max</div>
    <span asp-validation-for="Image" class="text-danger"></span>

    <label asp-for="Website" class="form-label"></label>
    <input asp-for="Website" class="form-control" type="url" />
    <span asp-validation-for="Website" class="text-danger"></span>

    <label asp-for="Email" class="form-label"></label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email" class="text-danger"></span>

    <label asp-for="SocialUrl" class="form-label"></label>
    <input asp-for="SocialUrl" class="form-control" type="url" />
    <span asp-validation-for="SocialUrl" class="text-danger"></span>

    <label asp-for="VideoUrl" class="form-label"></label>
    <input asp-for="VideoUrl" class="form-control" type="url" />
    <span asp-validation-for="VideoUrl" class="text-danger"></span>

    <div class="form-actions">
        <button class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
