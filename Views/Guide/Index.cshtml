@model GuideViewModel

@{
    ViewData["Title"] = "My voting guide";
}

<div class="d-flex flex-wrap justify-content-between gap-3 mb-4">
    <h1>My voting guide</h1>

    @if (Model.Candidates.Count > 0)
    {
        <div class="d-flex gap-2 no-print">
            <button class="btn btn-primary" type="button" data-print>Print guide</button>
            <form method="post" asp-action="Clear" data-confirm="Clear your guide?">
                <button class="btn btn-outline-secondary">Clear</button>
            </form>
        </div>
    }
</div>

@if (Model.Candidates.Count == 0)
{
    <p>No candidates selected. <a asp-controller="Home" asp-action="Index">Browse candidates</a></p>
}

@foreach (var city in Model.Candidates.GroupBy(c => new { c.Position.MunicipalityId, c.Position.Municipality.Name, c.Position.Municipality.ElectionDate }))
{
    <section class="mb-4">
        <h2 class="h4">@city.Key.Name</h2>
        <p>Election: @city.Key.ElectionDate.ToString("MMMM d, yyyy")</p>

        @foreach (var office in city.GroupBy(c => new { c.PositionId, c.Position.Name, c.Position.SeatsAvailable }))
        {
            <h3 class="h5">@office.Key.Name <span class="small text-body-secondary">(@office.Count() of @office.Key.SeatsAvailable selected)</span></h3>

            @if (office.Count() > office.Key.SeatsAvailable)
            {
                <p class="text-danger">Seat count changed. Remove extra selections.</p>
            }

            @foreach (var c in office)
            {
                <div class="guide-row border-bottom d-flex align-items-center gap-3 py-2">
                    <img class="portrait" src="@c.PhotoUrl" alt="Portrait of @c.Name" />
                    <span>@c.Name</span>
                    <form method="post" asp-action="Toggle" asp-route-id="@c.CandidateId" class="ms-auto no-print">
                        <input name="returnUrl" type="hidden" value="/Guide" />
                        <button class="btn btn-sm btn-outline-secondary" aria-label="Remove @c.Name from guide">Remove</button>
                    </form>
                </div>
            }
        }
    </section>
}

@if (Model.Candidates.Count > 0)
{
    <p class="small text-body-secondary">Print date: @DateTime.Now.ToString("MMMM d, yyyy") · Personal reference, not an official ballot.</p>
}

@section Scripts
{
    @if (Model.Print && Model.Candidates.Count > 0)
    {
        <script>
            window.addEventListener('load', () => window.print());
        </script>
    }
}
