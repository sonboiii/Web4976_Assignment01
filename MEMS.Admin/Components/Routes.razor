<Router AppAssembly="typeof(App).Assembly">
    <Found Context="route">
        <AuthorizeRouteView RouteData="route">
            <NotAuthorized><p>Sign in to manage elections.</p><a href="/admin/login">Administrator sign-in</a></NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="route" Selector="h1" />
    </Found>
</Router>
