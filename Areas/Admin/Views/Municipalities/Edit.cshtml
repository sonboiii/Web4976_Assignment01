@model MunicipalityForm

@{
    ViewData["Title"] = Model.MunicipalityId == 0 ? "Add municipality" : "Edit municipality";
}

<h1>@ViewData["Title"]</h1>

<form method="post" class="admin-form d-grid gap-2" enctype="multipart/form-data">
    <input asp-for="MunicipalityId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>

    <label asp-for="Province" class="form-label"></label>
    <input asp-for="Province" class="form-control" />
    <span asp-validation-for="Province" class="text-danger"></span>

    <label asp-for="ElectionDate" class="form-label"></label>
    <input asp-for="ElectionDate" class="form-control" />
    <span asp-validation-for="ElectionDate" class="text-danger"></span>

    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>

    <label asp-for="Image" class="form-label"></label>
    <input asp-for="Image" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" />
    <div class="form-text">JPG, PNG, or WebP · 2 MB max</div>
    <span asp-validation-for="Image" class="text-danger"></span>

    <div class="form-actions">
        <button class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
